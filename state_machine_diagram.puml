@startuml
skinparam StateBackgroundColor #FDFDFD
skinparam StateBorderColor #333333
skinparam DefaultTextAlignment center

[*] --> ثبت‌نشده : ایجاد اولیه سبد خرید

state ثبت‌نشده {
    [*] --> در_حال_ویرایش
    در_حال_ویرایش : افزودن/حذف اقلام کالا
}

ثبت‌نشده --> ثبت_شده : تایید نهایی سفارش توسط مشتری

state ثبت_شده {
    [*] --> در_انتظار_تایید_موجودی
    
    state در_انتظار_تایید_موجودی <<choice>>
    در_انتظار_تایید_موجودی --> در_انتظار_پرداخت : موجودی انبار کافی است
    در_انتظار_تایید_موجودی --> لغو_شده : کسری موجودی / عدم تایید
    
    در_انتظار_پرداخت --> تایید_شده : پرداخت موفق فاکتور
    در_انتظار_پرداخت --> لغو_شده : انقضای مهلت پرداخت
}

state تایید_شده {
    [*] --> در_حال_آماده‌سازی
    در_حال_آماده‌سازی : رزرو کالا و بسته‌بندی در انبار
    در_حال_آماده‌سازی --> آماده_ارسال : تکمیل بسته‌بندی و صدور بارنامه
}

state آماده_ارسال {
    [*] --> در_حال_ارسال
    در_حال_ارسال : تحویل به راننده و ناوگان لجستیک
}

در_حال_ارسال --> تحویل_شده : تحویل موفق به مشتری
در_حال_ارسال --> مرجوع_شده : عدم پذیرش یا آسیب در حمل

تحویل_شده --> [*]
لغو_شده --> [*]
مرجوع_شده --> [*]

@enduml
