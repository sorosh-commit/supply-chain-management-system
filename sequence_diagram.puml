@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "مشتری / واحد فروش" as User
participant "سامانه (UI / Web)" as UI
participant "کنترلر سفارش" as Controller
participant "مدیریت انبار" as Inventory
database "پایگاه داده" as DB

User -> UI: درخواست ثبت سفارش فروش جدید
activate UI

UI -> Controller: ارسال اطلاعات اقلام سفارش
activate Controller

Controller -> DB: بررسی مشخصات و اعتبار مشتری
activate DB
DB --> Controller: تایید اعتبار مشتری
deactivate DB

Controller -> Inventory: بررسی موجودی کالا (Stock Check)
activate Inventory

Inventory -> DB: استعلام موجودی انبار
activate DB
DB --> Inventory: بازگشت مقدار موجودی فعلی
deactivate DB

alt موجودی انبار کافی باشد
    Inventory --> Controller: تایید موجودی و رزرو کالا
    deactivate Inventory
    
    Controller -> DB: ثبت سفارش فروش و به‌روزرسانی موجودی
    activate DB
    DB --> Controller: تایید ذخیره‌سازی موفق
    deactivate DB
    
    Controller -> UI: بازگرداندن پیام موفقیت و شماره پیگیری
    UI --> User: نمایش تاییدیه سفارش و فاکتور اولیه

else موجودی انبار ناکافی باشد
    Inventory --> Controller: اعلام کسری موجودی
    deactivate Inventory
    Controller --> UI: ارسال خطای عدم موجودی
    UI --> User: نمایش پیام خطا (کسری موجودی)
end

deactivate Controller
deactivate UI
@enduml
