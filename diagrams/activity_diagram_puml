@startuml

skinparam defaultTextAlignment center
skinparam ActivityBackgroundColor #F9F9F9
skinparam ActivityBorderColor #333333

|مسئول خرید|

start

:بررسی موجودی انبار و تشخیص نیاز به خرید;
:ثبت سفارش خرید PO در سیستم;

|سامانه|

:تولید شماره پیگیری و ثبت سفارش;
:ارسال اعلان سفارش به تأمین‌کننده;

|تأمین‌کننده|

if (قبول سفارش؟) then (بله)

    :آماده‌سازی اقلام و ارسال محموله;

    |انباردار|

    :دریافت محموله در انبار;
    :بررسی فیزیکی و کیفی اقلام;

    if (اقلام سالم و مطابق فاکتور هستند؟) then (بله)

        |سامانه|

        :ثبت تراکنش ورود کالا Stock In;
        :به‌روزرسانی موجودی انبار در دیتابیس;
        :تأیید نهایی فاکتور خرید;

        |مسئول خرید|

        :تغییر وضعیت سفارش به تکمیل‌شده;

    else (خیر)

        |انباردار|

        :ثبت گزارش مرجوعی و کسری;

        |سامانه|

        :ارسال هشدار به تأمین‌کننده جهت اصلاح;
        :تغییر وضعیت سفارش به نیازمند اصلاح;

    endif

else (خیر)

    |تأمین‌کننده|

    :اعلام دلیل رد سفارش;

    |سامانه|

    :لغو سفارش خرید و بستن پرونده;

endif

stop

@enduml
