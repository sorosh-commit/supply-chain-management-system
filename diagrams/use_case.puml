@startuml
left to right direction
actor "مدیر سیستم" as Admin
actor "مدیر انبار" as Manager
actor "اپراتور لجستیک" as Operator
actor "تأمین‌کننده" as SupplierActor
actor "مشتری" as Customer

rectangle "سامانه سازمانی مدیریت انبار و زنجیره تأمین" {
    usecase "مدیریت کاربران و سطح دسترسی" as UC1
    usecase "مدیریت انبارها و پایش ظرفیت" as UC2
    usecase "مدیریت کالاها و کدهای SKU" as UC3
    usecase "ثبت و مدیریت تأمین‌کنندگان" as UC4
    usecase "ثبت تراکنش‌های ورود و خروج" as UC5
    usecase "مشاهده گزارشات ممیزی و گردش کالا" as UC6
    usecase "مشاهده سفارشات و وضعیت ارسال" as UC7
    usecase "ثبت و مدیریت سفارشات خرید (PO)" as UC8
    usecase "ثبت سفارشات فروش" as UC9
    usecase "تعیین نقطه سفارش (Threshold)" as UC10
    usecase "مدیریت خودروها و رانندگان" as UC11
    usecase "صدور بارنامه و شیپمنت" as UC12
    usecase "مدیریت دسته‌بندی کالاها" as UC13
}

Admin --> UC1
Admin --> UC3
Admin --> UC4
Admin --> UC6
Admin --> UC13

Manager --> UC2
Manager --> UC5
Manager --> UC6
Manager --> UC8
Manager --> UC10

Operator --> UC5
Operator --> UC6
Operator --> UC11
Operator --> UC12

SupplierActor --> UC7
SupplierActor --> UC8

Customer --> UC9
Customer --> UC7
@enduml
